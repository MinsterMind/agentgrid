{
  "appId": "com.minstermind.agentgrid",
  "productName": "AgentGrid",
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "directories": { "output": "release", "buildResources": "build" },
  "files": ["dist/**/*", "package.json"],
  "extraResources": [
    { "from": "../ui/dist", "to": "ui" },
    { "from": "../server/roles", "to": "roles" }
  ],
  "asar": true,
  "asarUnpack": ["**/node_modules/node-pty/**", "**/node_modules/@anthropic-ai/claude-agent-sdk/**"],
  "npmRebuild": true,
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
    "icon": "build/icon.png",
    "identity": null,
    "hardenedRuntime": false,
    "darkModeSupport": true
  },
  "dmg": { "contents": [{ "x": 130, "y": 200 }, { "x": 410, "y": 200, "type": "link", "path": "/Applications" }] },
  "linux": { "target": ["AppImage"], "category": "Development", "icon": "build/icon.png" }
}
