{
  "name": "@agentgrid/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AgentGrid desktop app \u2014 run a roster of Claude Code agents from one window",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --config electron-builder.json",
    "dist:mac": "npm run build && electron-builder --config electron-builder.json --mac",
    "dist:linux": "npm run build && electron-builder --config electron-builder.json --linux"
  },
  "dependencies": {
    "@agentgrid/server": "*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "44.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "author": "MinsterMind"
}
